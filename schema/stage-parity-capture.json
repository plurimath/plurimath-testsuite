{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plurimath.org/testsuite/schema/stage-parity-capture/1",
  "title": "Tree parity capture",
  "description": "One side (legacy facade or candidate stage gem) of a legacy-versus-gem parity run for one language: the exact pins, then one row per input with its status and the values at each boundary in canonical tagged form. See docs/tree-parity-contract.adoc.",
  "type": "object",
  "required": [
    "schema",
    "language",
    "side",
    "pins",
    "inventory",
    "rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "plurimath-stage/parity-capture/1"
    },
    "language": {
      "type": "string",
      "enum": [
        "asciimath",
        "latex",
        "unicode",
        "mathml",
        "omml",
        "html"
      ]
    },
    "side": {
      "type": "string",
      "enum": [
        "legacy",
        "candidate"
      ]
    },
    "pins": {
      "type": "object",
      "required": [
        "producer",
        "testsuite",
        "inputs_sha256",
        "environment"
      ],
      "additionalProperties": false,
      "properties": {
        "producer": {
          "type": "object",
          "required": [
            "repository",
            "commit"
          ],
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "testsuite": {
          "type": "object",
          "required": [
            "commit",
            "language",
            "generation",
            "snapshot_digest"
          ],
          "additionalProperties": false,
          "properties": {
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "language": {
              "type": "string"
            },
            "generation": {
              "type": "integer",
              "minimum": 1
            },
            "snapshot_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "inputs_sha256": {
          "description": "sha256 of the capture input inventory file.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "environment": {
          "description": "Ruby, lockfile, compiler, binding and LML identities of the isolated environment.",
          "type": "object",
          "minProperties": 1
        }
      }
    },
    "inventory": {
      "description": "Expected input count. A capture with missing or duplicate ids fails.",
      "type": "object",
      "required": [
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "expected": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
    },
    "options": {
      "description": "Caller options, as given (decimal, locale, ...). Values are strings, booleans or null so nothing is reinterpreted.",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "spec": {
      "description": "The specification section a row comes from.",
      "type": "object",
      "required": [
        "document",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refusal": {
      "description": "A real parse refusal: category and position are contractual; message prose is not.",
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "byte_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "value": {
      "description": "Canonical tagged form of one Ruby value: exactly one tag key per node. It keeps hash vs array, symbol vs string keys, key order, nil vs missing (a missing key is simply absent from `hash`), empty string vs empty list, node class, slice text and byte offsets. Numbers keep their source text; nothing is float-normalized and no child order is sorted.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "nil"
          ],
          "additionalProperties": false,
          "properties": {
            "nil": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bool"
          ],
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "int"
          ],
          "additionalProperties": false,
          "properties": {
            "int": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "float"
          ],
          "additionalProperties": false,
          "properties": {
            "float": {
              "description": "Float#inspect text, unchanged.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "decimal"
          ],
          "additionalProperties": false,
          "properties": {
            "decimal": {
              "description": "BigDecimal#to_s text, unchanged.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "str"
          ],
          "additionalProperties": false,
          "properties": {
            "str": {
              "description": "A valid UTF-8 string.",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bytes",
            "encoding"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "description": "Lowercase hex of a string that is not valid UTF-8.",
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "encoding": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sym"
          ],
          "additionalProperties": false,
          "properties": {
            "sym": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "array"
          ],
          "additionalProperties": false,
          "properties": {
            "array": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "hash"
          ],
          "additionalProperties": false,
          "properties": {
            "hash": {
              "description": "Key/value pairs in insertion order.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/pair"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "node",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "node": {
              "description": "Class or node kind name.",
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "description": "Declared field name/value pairs, in declaration order.",
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "slice",
            "byte_offset"
          ],
          "additionalProperties": false,
          "properties": {
            "slice": {
              "description": "Parslet::Slice text.",
              "type": "string"
            },
            "byte_offset": {
              "type": "integer",
              "minimum": 0
            },
            "char_offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "$ref": "#/$defs/value"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "row": {
      "type": "object",
      "required": [
        "id",
        "input",
        "options",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "input": {
          "description": "Caller input, tagged so invalid UTF-8 survives.",
          "$ref": "#/$defs/value"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "status": {
          "description": "`refused` is data. `timed-out` and `crashed` mean the capture is incomplete, and parity fails.",
          "type": "string",
          "enum": [
            "succeeded",
            "refused",
            "timed-out",
            "crashed"
          ]
        },
        "preprocessed": {
          "$ref": "#/$defs/value"
        },
        "raw": {
          "description": "Raw grammar tree.",
          "$ref": "#/$defs/value"
        },
        "model": {
          "description": "Typed model mapped through declared fields; never object inspect.",
          "$ref": "#/$defs/value"
        },
        "writers": {
          "description": "Target name to exact output bytes.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "refusal": {
          "$ref": "#/$defs/refusal"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "refused"
              }
            }
          },
          "then": {
            "required": [
              "refusal"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "raw"
            ]
          }
        }
      ]
    }
  }
}
