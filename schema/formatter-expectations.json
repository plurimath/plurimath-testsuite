{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Authored number formatter component outputs",
  "type": "object",
  "properties": {
    "schema": {
      "const": "plurimath-fixtures/formatter-expectations/1"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "repository": {
          "const": "https://github.com/plurimath/plurimath"
        },
        "ruby_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      },
      "required": [
        "repository",
        "ruby_commit"
      ],
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z-]+-[0-9]+$"
          },
          "component": {
            "enum": [
              "BaseNotation",
              "FormatOptions",
              "FormattedNotation",
              "FormattedNumber",
              "Fraction",
              "Integer",
              "NotationRenderer",
              "Parts",
              "SignRenderer",
              "Significant",
              "Source"
            ]
          },
          "input": {
            "$ref": "#/$defs/operation"
          },
          "comparison": {
            "enum": [
              "eq",
              "nil",
              "alphabet",
              "max_length",
              "text_kind"
            ]
          },
          "expected": {},
          "source": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^spec/plurimath/formatter/numbers/[a-z_]+_spec\\.rb$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "contexts": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "path",
              "sha256",
              "line",
              "contexts"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "component",
          "input",
          "comparison",
          "expected",
          "source"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "comparison": {
                  "const": "eq"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "comparison": {
                  "const": "nil"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "null"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "comparison": {
                  "const": "alphabet"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "comparison": {
                  "const": "max_length"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "comparison": {
                  "const": "text_kind"
                }
              }
            },
            "then": {
              "properties": {
                "expected": {
                  "const": "text"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "provenance",
    "cases"
  ],
  "additionalProperties": false,
  "$defs": {
    "literal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "literal"
        },
        "value": {
          "type": [
            "null",
            "boolean",
            "string",
            "number"
          ]
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "symbol": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "symbol"
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "additionalProperties": false
    },
    "array": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "array"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe"
          }
        }
      },
      "required": [
        "kind",
        "items"
      ],
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "map"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/literal"
                  },
                  {
                    "$ref": "#/$defs/symbol"
                  }
                ]
              },
              "value": {
                "$ref": "#/$defs/recipe"
              }
            },
            "required": [
              "key",
              "value"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "entries"
      ],
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "component"
        },
        "name": {
          "enum": [
            "BaseNotation",
            "FormatOptions",
            "FormattedNotation",
            "FormattedNumber",
            "Fraction",
            "Integer",
            "NotationRenderer",
            "Parts",
            "SignRenderer",
            "Significant",
            "Source"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe"
          }
        },
        "kwargs": {
          "$ref": "#/$defs/map"
        }
      },
      "required": [
        "kind",
        "name",
        "args",
        "kwargs"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "operation"
        },
        "receiver": {
          "$ref": "#/$defs/recipe"
        },
        "method": {
          "enum": [
            "wrap",
            "to_s",
            "formatted_exponent",
            "sign_text",
            "digits_string",
            "format",
            "format_groups",
            "change_base",
            "apply",
            "chop_group",
            "number_to_base",
            "render",
            "coefficient",
            "apply_parts",
            "to_parts"
          ]
        },
        "args": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe"
          }
        },
        "kwargs": {
          "$ref": "#/$defs/map"
        }
      },
      "required": [
        "kind",
        "receiver",
        "method",
        "args",
        "kwargs"
      ],
      "additionalProperties": false
    },
    "recipe": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "literal",
            "symbol",
            "array",
            "map",
            "component",
            "operation"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "literal"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/literal"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "symbol"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/symbol"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "array"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/array"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "map"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/map"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "component"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/component"
          }
        },
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "const": "operation"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/operation"
          }
        }
      ]
    }
  },
  "$id": "https://plurimath.org/testsuite/formatter-expectations/1"
}
