{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plurimath.org/schema/facade-successors/1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "plurimath-facade/successors/1"
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*-v[1-9][0-9]*$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "const": "https://github.com/plurimath/plurimath"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "ruby": {
          "type": "string",
          "minLength": 1
        },
        "lockfile_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generator_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dependencies": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "repository",
        "commit",
        "ruby",
        "lockfile_sha256",
        "generator_sha256",
        "dependencies"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^(corpus/(asciimath|latex|mathml|omml)/[a-z0-9-]+\\.yaml|fixtures/renderer-expectations\\.yaml)$"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "id",
              "sha256"
            ]
          },
          "expected": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": false,
            "properties": {
              "omml": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "output": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "output"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "error"
                    ],
                    "properties": {
                      "error": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "category",
                          "error_class",
                          "message"
                        ],
                        "properties": {
                          "category": {
                            "const": "parse_error"
                          },
                          "error_class": {
                            "enum": [
                              "Plurimath::Error",
                              "Plurimath::Math::ParseError"
                            ]
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "latex": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "output": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "output"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "error"
                    ],
                    "properties": {
                      "error": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "category",
                          "error_class",
                          "message"
                        ],
                        "properties": {
                          "category": {
                            "const": "parse_error"
                          },
                          "error_class": {
                            "enum": [
                              "Plurimath::Error",
                              "Plurimath::Math::ParseError"
                            ]
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                ]
              },
              "asciimath": {
                "oneOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "error"
                    ],
                    "properties": {
                      "error": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "category",
                          "error_class",
                          "message"
                        ],
                        "properties": {
                          "category": {
                            "const": "parse_error"
                          },
                          "error_class": {
                            "enum": [
                              "Plurimath::Error",
                              "Plurimath::Math::ParseError"
                            ]
                          },
                          "message": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      }
                    }
                  }
                ]
              }
            }
          },
          "refusals": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "render_slot": {
                  "type": "string",
                  "pattern": "^v[1-9][0-9]*$"
                },
                "assertion_line": {
                  "type": "integer",
                  "minimum": 1
                },
                "error_class": {
                  "enum": [
                    "Plurimath::Error",
                    "Plurimath::Math::ParseError"
                  ]
                },
                "message": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "render_slot",
                "assertion_line",
                "error_class",
                "message"
              ]
            }
          }
        },
        "required": [
          "id",
          "source"
        ],
        "oneOf": [
          {
            "required": [
              "expected"
            ],
            "not": {
              "required": [
                "refusals"
              ]
            }
          },
          {
            "required": [
              "refusals"
            ],
            "not": {
              "required": [
                "expected"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema",
    "profile",
    "producer",
    "cases"
  ]
}
