{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plurimath.org/testsuite/schema/stage-cases/1",
  "title": "Stage cases",
  "description": "A stage-gem payload: rows whose expectations are the raw grammar tree or the typed model of one language, in canonical tagged form, or a refusal. Used by stage-gem producers beside, never instead of, the legacy facade payloads of earlier generations. See docs/tree-parity-contract.adoc.",
  "type": "object",
  "required": [
    "schema",
    "group",
    "description",
    "boundary",
    "cases"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "pattern": "^plurimath-stage/(asciimath|latex|unicode|mathml|omml|html)/cases/1$"
    },
    "group": {
      "description": "Matches the file name without its extension.",
      "$ref": "#/$defs/slug"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "boundary": {
      "type": "string",
      "enum": [
        "raw-tree",
        "typed-model"
      ]
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([._-][a-z0-9]+)*$"
    },
    "options": {
      "description": "Caller options, as given (decimal, locale, ...). Values are strings, booleans or null so nothing is reinterpreted.",
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "boolean",
          "null"
        ]
      }
    },
    "spec": {
      "description": "The specification section a row comes from.",
      "type": "object",
      "required": [
        "document",
        "section"
      ],
      "additionalProperties": false,
      "properties": {
        "document": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "refusal": {
      "description": "A real parse refusal: category and position are contractual; message prose is not.",
      "type": "object",
      "required": [
        "category"
      ],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        },
        "byte_offset": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "value": {
      "description": "Canonical tagged form of one Ruby value: exactly one tag key per node. It keeps hash vs array, symbol vs string keys, key order, nil vs missing (a missing key is simply absent from `hash`), empty string vs empty list, node class, slice text and byte offsets. Numbers keep their source text; nothing is float-normalized and no child order is sorted.",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "nil"
          ],
          "additionalProperties": false,
          "properties": {
            "nil": {
              "const": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bool"
          ],
          "additionalProperties": false,
          "properties": {
            "bool": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "int"
          ],
          "additionalProperties": false,
          "properties": {
            "int": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "float"
          ],
          "additionalProperties": false,
          "properties": {
            "float": {
              "description": "Float#inspect text, unchanged.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "decimal"
          ],
          "additionalProperties": false,
          "properties": {
            "decimal": {
              "description": "BigDecimal#to_s text, unchanged.",
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "str"
          ],
          "additionalProperties": false,
          "properties": {
            "str": {
              "description": "A valid UTF-8 string.",
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "bytes",
            "encoding"
          ],
          "additionalProperties": false,
          "properties": {
            "bytes": {
              "description": "Lowercase hex of a string that is not valid UTF-8.",
              "type": "string",
              "pattern": "^([0-9a-f]{2})*$"
            },
            "encoding": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sym"
          ],
          "additionalProperties": false,
          "properties": {
            "sym": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "array"
          ],
          "additionalProperties": false,
          "properties": {
            "array": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "hash"
          ],
          "additionalProperties": false,
          "properties": {
            "hash": {
              "description": "Key/value pairs in insertion order.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/pair"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "node",
            "fields"
          ],
          "additionalProperties": false,
          "properties": {
            "node": {
              "description": "Class or node kind name.",
              "type": "string",
              "minLength": 1
            },
            "fields": {
              "description": "Declared field name/value pairs, in declaration order.",
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "$ref": "#/$defs/value"
                  }
                ],
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "slice",
            "byte_offset"
          ],
          "additionalProperties": false,
          "properties": {
            "slice": {
              "description": "Parslet::Slice text.",
              "type": "string"
            },
            "byte_offset": {
              "type": "integer",
              "minimum": 0
            },
            "char_offset": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "pair": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "$ref": "#/$defs/value"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "case": {
      "type": "object",
      "required": [
        "id",
        "input",
        "options",
        "expected"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "input": {
          "$ref": "#/$defs/value"
        },
        "options": {
          "$ref": "#/$defs/options"
        },
        "spec": {
          "$ref": "#/$defs/spec"
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "preprocessed",
                "tree"
              ],
              "additionalProperties": false,
              "properties": {
                "preprocessed": {
                  "$ref": "#/$defs/value"
                },
                "tree": {
                  "$ref": "#/$defs/value"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "refusal"
              ],
              "additionalProperties": false,
              "properties": {
                "refusal": {
                  "$ref": "#/$defs/refusal"
                }
              }
            }
          ]
        }
      }
    }
  }
}
