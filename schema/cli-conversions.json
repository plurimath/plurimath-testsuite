{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source",
    "cases"
  ],
  "properties": {
    "schema": {
      "const": "plurimath-fixtures/cli-conversions/1"
    },
    "source": {
      "type": "object",
      "required": [
        "revision",
        "files"
      ],
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "arguments",
          "stdout",
          "source"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^cli-convert-[0-9]+$"
          },
          "arguments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "stdout": {
            "type": "string"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "line",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "line": {
                "type": "integer",
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "input_file": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "content"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "content": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plurimath.org/testsuite/schema/cli-conversions/1",
  "title": "Authored CLI conversion inputs and stdout expectations"
}
